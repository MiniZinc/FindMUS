{
    "executable": "./findMUS",
    "id": "org.minizinc.findmus",
    "isGUIApplication": false,
    "mznlib": "-Ggecode",
    "name": "findMUS",
    "supportsMzn": false,
    "version": "0.1.1",
    "needsSolns2Out": false,
    "needsStdlibDir": true,
    "needsPathsFile": true,
    "needsMznExecutable": false,
    "stdFlags": ["--output-html", "-v", "-s", "-a", "-n", "-t"],
    "extraFlags": [
      ["--paramset", "Preset parameters", "string:hint:mzn:fzn", "hint"],
      ["--solver", "Which solver to use for SAT checking", "string", "gecode"],
      ["--no-restart", "Disable restart to leaves behaviour", "bool", "false"],
      ["--output-json", "Print MUSes in JSON format", "bool", "false"],
      ["--structure", "Alter initial structure", "string:flat:gen:normal:mix:idx:idxmix", "gen"],
      ["--no-binarize", "Do not inject arbitrary structure", "bool", "false"],
      ["--depth", "Abstraction level of MUSes", "string:mzn:fzn:1:5:25:100", "mzn"],
      ["--verbose", "Verbose output", "bool", "false"],
      ["--verbose-subsolve", "Verbosity level for subsolving", "int:0:1", "0"],
      ["--verbose-enum", "Verbosity level for enumeration", "int:0:1", "0"],
      ["--verbose-map", "Verbosity level for map calls", "int:0:1", "0"],
      ["--stdlib-dir", "Location of MiniZinc stdlib directory.", "string", ""],
      ["--no-progress", "Disable mzn-progress output for IDE", "bool", "false"],
      ["--filter-path", "Filter constraints based on comma separated substrings of path", "string", ""],
      ["--filter-name", "Filter constraints based on comma separated substrings of expression and constraint names", "string", ""],
      ["--dump-dot", "Write tree to GraphViz file", "string"],
      ["--output-brief", "Do not output traces.", "bool"],
      ["--shrink-alg", "Select MUS shrink algorithm {lin, map_lin, qx, map_qx}", "string"],
      ["--soft-defines", "Consider functional constraints as part of MUSes.", "bool"],
      ["--help", "Extra help information", "bool"],
    ]
}
